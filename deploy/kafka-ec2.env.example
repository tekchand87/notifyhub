# Copy this file to an untracked file on the EC2 host, for example:
#   cp deploy/kafka-ec2.env.example .env.kafka-ec2
# Then use it with --env-file. Do not commit the copied file.

# Public address clients use to bootstrap Kafka.
KAFKA_PUBLIC_HOST=13.207.193.82
KAFKA_BROKERS=13.207.193.82:9092

# NotifyHub topic contract. These values must match the application settings.
KAFKA_TOPIC=notifyhub.events
KAFKA_DLQ_TOPIC=notifyhub.events.dlq
KAFKA_TOPIC_PARTITIONS=6
KAFKA_DLQ_TOPIC_PARTITIONS=1
