# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── MongoDB ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://notifyhub:notifyhub_password@localhost:27017/notifyhub?authSource=admin

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=1d

# ─── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_PRODUCER_CLIENT_ID=notifyhub-api
KAFKA_CONSUMER_CLIENT_ID=notifyhub-worker
KAFKA_TOPIC=notifyhub.events
KAFKA_GROUP_ID=notifyhub-workers
# DLQ topic — events that exceed max retry attempts are published here
KAFKA_DLQ_TOPIC=notifyhub.events.dlq

# ─── SMTP (Email delivery) ───────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com

# ─── CORS (Bug #7) ───────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Development: http://localhost:5173 (Vite dev server default)
# Production: https://app.yourdomain.com
# NEVER use "*" for production authenticated APIs.
CORS_ORIGINS=http://localhost:5173

# ─── Webhook delivery ────────────────────────────────────────────────────────
# Request timeout for outgoing webhook HTTP POSTs (milliseconds)
WEBHOOK_TIMEOUT_MS=10000
# Set to true ONLY in local development to allow webhooks targeting localhost/private IPs.
# NEVER set to true in production — SSRF risk.
# Note: this is read at process startup via dotenv.config(). A restart is required
# after changing this value in .env — there is no dynamic reload.
WEBHOOK_ALLOW_LOCALHOST=false

# ─── Rate limiting ────────────────────────────────────────────────────────────
# Current implementation: in-memory (express-rate-limit default).
# IMPORTANT: in-memory rate limiting is NOT shared across multiple Node.js instances.
# For multi-instance (AWS ECS/EKS) production deployments, replace with a Redis-backed
# store using rate-limit-redis: https://github.com/express-rate-limit/rate-limit-redis
#
# To enable Redis-backed rate limiting:
#   1. Add: npm install rate-limit-redis ioredis
#   2. Set: RATE_LIMIT_STORE=redis
#   3. Set: REDIS_URL=redis://your-redis-host:6379
#
# Development / single-instance:
# RATE_LIMIT_STORE=memory (default — no Redis needed)
#
# Production multi-instance:
# RATE_LIMIT_STORE=redis
# REDIS_URL=redis://your-redis-host:6379

# ─── Retry / Delivery ────────────────────────────────────────────────────────
# Maximum total delivery attempts per event (first attempt + retries)
MAX_DELIVERY_ATTEMPTS=5
# Base delay for exponential backoff (milliseconds)
RETRY_BASE_DELAY_MS=1000
# Maximum delay cap after backoff + jitter (milliseconds, default 5 minutes)
RETRY_MAX_DELAY_MS=300000
# How often the retry poller checks for due retries (milliseconds)
RETRY_POLLER_INTERVAL_MS=5000

# ─── Idempotency ─────────────────────────────────────────────────────────────
# How long idempotency records are retained before auto-expiry (hours)
# MongoDB TTL index auto-removes expired records — no cron job needed
IDEMPOTENCY_TTL_HOURS=24

# ─── Outbox Publisher ────────────────────────────────────────────────────────
# How often the outbox publisher polls for pending records (milliseconds)
OUTBOX_POLL_INTERVAL_MS=1000
# Maximum OutboxEvent records to publish per poll cycle
OUTBOX_BATCH_SIZE=50
# Maximum publish attempts before marking an OutboxEvent as permanently failed
OUTBOX_MAX_ATTEMPTS=5
# Records stuck in "publishing" longer than this (ms) are considered stale and recovered
OUTBOX_STALE_MS=60000

# ─── Worker Lease / Crash Recovery ───────────────────────────────────────────
# How long a worker may hold a processing lease before being considered crashed (ms)
# Must be longer than the longest expected single delivery attempt (email + webhook timeout)
# Shorter = faster recovery but risks double-processing if worker is slow
PROCESSING_LEASE_MS=300000
# How often the stale-lease recovery poller runs (milliseconds)
LEASE_RECOVERY_INTERVAL_MS=60000
