# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── MongoDB ─────────────────────────────────────────────────────────────────
# Local host development (run MongoDB on the host):
MONGODB_URI=mongodb://notifyhub:notifyhub_password@localhost:27017/notifyhub?authSource=admin
# Docker Compose overrides this with the service hostname `mongodb` (see
# docker.env.example). AWS/ECS must inject an Atlas SRV URI at runtime instead:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
# Never commit the Atlas value or place credentials in this file.

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=1d

# ─── Kafka ───────────────────────────────────────────────────────────────────
# Local/default event broker. Set EVENT_BROKER=sqs only for AWS/ECS deployments.
EVENT_BROKER=kafka
# Host-local Docker Kafka uses localhost:9092. In ECS/MSK, set a comma-separated
# list of bootstrap broker endpoints (for example, the TLS 9098 endpoints).
KAFKA_BROKERS=localhost:9092
# KAFKA_BROKERS=b-1.example:9098,b-2.example:9098,b-3.example:9098
# Optional managed-Kafka client settings. Keep these disabled for local PLAINTEXT Kafka.
KAFKA_PRODUCER_CLIENT_ID=notifyhub-api
KAFKA_CONSUMER_CLIENT_ID=notifyhub-worker
KAFKA_SSL=false
# For Amazon MSK TLS + SCRAM, set KAFKA_SSL=true and provide all three SASL
# variables from ECS/Secrets Manager. Never commit these values.
# KAFKA_SASL_MECHANISM=scram-sha-512
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# MSK IAM authentication is a separate KafkaJS signer-based mechanism; these
# username/password settings intentionally do not claim to enable MSK IAM.
KAFKA_CONNECTION_TIMEOUT_MS=10000
KAFKA_AUTHENTICATION_TIMEOUT_MS=10000
KAFKA_REQUEST_TIMEOUT_MS=30000
KAFKA_TOPIC=notifyhub.events
KAFKA_GROUP_ID=notifyhub-workers
# DLQ topic — events that exceed max retry attempts are published here
KAFKA_DLQ_TOPIC=notifyhub.events.dlq
# Kafka producer: durable acknowledgements and idempotent retry are always used.
# GZIP reduces network and broker I/O for event payloads; set "none" only after measuring.
KAFKA_COMPRESSION=gzip
KAFKA_MAX_IN_FLIGHT_REQUESTS=5
KAFKA_PRODUCER_TIMEOUT_MS=30000
# Consumer fetch tuning. Kafka still commits offsets only after each message handler settles.
KAFKA_CONSUMER_MIN_BYTES=32768
KAFKA_CONSUMER_MAX_BYTES=10485760
KAFKA_CONSUMER_MAX_BYTES_PER_PARTITION=1048576
KAFKA_CONSUMER_MAX_WAIT_MS=50

# ─── Amazon SQS event broker (AWS/ECS only) ───────────────────────────────────
# EVENT_BROKER=sqs
# AWS_REGION=ap-south-1
# SQS_EVENTS_QUEUE_URL=
# Optional documentation value; SQS redrive policy, not application code,
# moves failed queue messages to this DLQ.
# SQS_DLQ_QUEUE_URL=
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT_SECONDS=60
SQS_MAX_MESSAGES=10

# ─── SMTP (Email delivery) ───────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com

# ─── CORS (Bug #7) ───────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Development: http://localhost:5173 (Vite dev server default)
# Production: https://app.yourdomain.com
# NEVER use "*" for production authenticated APIs.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Webhook delivery ────────────────────────────────────────────────────────
# Request timeout for outgoing webhook HTTP POSTs (milliseconds)
WEBHOOK_TIMEOUT_MS=10000
# Set to true ONLY in local development to allow webhooks targeting localhost/private IPs.
# NEVER set to true in production — SSRF risk.
# Note: this is read at process startup via dotenv.config(). A restart is required
# after changing this value in .env — there is no dynamic reload.
WEBHOOK_ALLOW_LOCALHOST=false
# Development only: permit HTTP webhook URLs. Production always requires HTTPS.
WEBHOOK_ALLOW_INSECURE_HTTP=false
# Stored webhook response bytes are capped; excess data is discarded without buffering.
WEBHOOK_MAX_RESPONSE_BYTES=8192

# ─── MongoDB connection behavior ─────────────────────────────────────────────
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=5
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_RETRY_WRITES=true

# ─── Rate limiting ────────────────────────────────────────────────────────────
# All API processes share Redis token buckets; there is no process-local counter.
# redis:// is suitable only for local/private networks. Use rediss:// plus a secret
# manager-backed URL for production Redis TLS/authentication.
RATE_LIMIT_ENABLED=true
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=1000
# Explicit outage policy: fail-open favors API availability; fail-closed protects
# capacity at the cost of 503s. Set deliberately in production.
RATE_LIMIT_FAILURE_MODE=fail-open
# Only set this to known proxy IPs/CIDRs (or an Express trust-proxy preset). Leave
# unset locally so X-Forwarded-For cannot spoof the client IP rate-limit identity.
# TRUST_PROXY=loopback

# Token buckets: sustained requests/events per second and maximum immediate burst.
# Validate these candidate limits with load tests before production rollout.
AUTH_RATE_LIMIT_PER_SECOND=0.011111
AUTH_RATE_LIMIT_BURST=10
IP_RATE_LIMIT_PER_SECOND=1000
IP_RATE_LIMIT_BURST=2000
GLOBAL_EVENT_RATE_LIMIT_PER_SECOND=1000
GLOBAL_EVENT_RATE_LIMIT_BURST=2000
TENANT_RATE_LIMIT_PER_SECOND=1000
TENANT_RATE_LIMIT_BURST=2000
API_KEY_RATE_LIMIT_PER_SECOND=1000
API_KEY_RATE_LIMIT_BURST=2000
# Tenant-specific ingestionRateLimit fields override the tenant defaults. This
# short cache prevents an extra Mongo query for each event request.
TENANT_QUOTA_CACHE_TTL_MS=60000
API_KEY_LAST_USED_UPDATE_MS=300000

# ─── Authentication / worker lifecycle ───────────────────────────────────────
# Keep access tokens short-lived. Password changes increment tokenVersion and
# invalidate all previously issued access tokens on their next authenticated use.
JWT_ACCESS_EXPIRES_IN=15m
WORKER_SHUTDOWN_TIMEOUT_MS=30000

# ─── Kafka topic contract ────────────────────────────────────────────────────
# Provision these declaratively before app/worker startup. The worker validates
# their presence and minimum partition count; it never creates or alters topics.
KAFKA_TOPIC_PARTITIONS=6
KAFKA_DLQ_TOPIC_PARTITIONS=1

# ─── Retry / Delivery ────────────────────────────────────────────────────────
# Maximum total delivery attempts per event (first attempt + retries)
MAX_DELIVERY_ATTEMPTS=5
# Base delay for exponential backoff (milliseconds)
RETRY_BASE_DELAY_MS=1000
# Maximum delay cap after backoff + jitter (milliseconds, default 5 minutes)
RETRY_MAX_DELAY_MS=300000
# How often the retry poller checks for due retries (milliseconds)
RETRY_POLLER_INTERVAL_MS=5000

# ─── Idempotency ─────────────────────────────────────────────────────────────
# How long idempotency records are retained before auto-expiry (hours)
# MongoDB TTL index auto-removes expired records — no cron job needed
IDEMPOTENCY_TTL_HOURS=24
# How long a pending reservation is held after a process interruption (milliseconds).
# Keep this above normal Mongo transaction time; it is not the response-cache TTL.
IDEMPOTENCY_PENDING_LEASE_MS=60000

# ─── Outbox Publisher ────────────────────────────────────────────────────────
# How long an idle outbox publisher waits before checking for new records (milliseconds).
# A full batch is followed immediately; this value is not inserted between full batches.
OUTBOX_POLL_INTERVAL_MS=25
# Maximum OutboxEvent records claimed and published in one Kafka batch.
OUTBOX_BATCH_SIZE=500
# Maximum concurrent atomic MongoDB claims while filling an outbox batch.
OUTBOX_CONCURRENCY=50
# Maximum publish attempts before marking an OutboxEvent as permanently failed
OUTBOX_MAX_ATTEMPTS=5
# Records stuck in "publishing" longer than this (ms) are considered stale and recovered
OUTBOX_STALE_MS=60000

# ─── Worker Lease / Crash Recovery ───────────────────────────────────────────
# Maximum Kafka partitions and retry deliveries processed concurrently per worker process.
# Kafka preserves message order inside each partition; actual Kafka parallelism is capped
# by the number of partitions assigned to this consumer instance.
WORKER_CONCURRENCY=10
# How long a worker may hold a processing lease before being considered crashed (ms)
# Must be longer than the longest expected single delivery attempt (email + webhook timeout)
# Shorter = faster recovery but risks double-processing if worker is slow
PROCESSING_LEASE_MS=300000
# How often the stale-lease recovery poller runs (milliseconds)
LEASE_RECOVERY_INTERVAL_MS=60000
