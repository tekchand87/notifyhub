# Production image for the NotifyHub notification worker.
# The worker uses the same application dependencies as the API but has its own
# image and process entry point so it can be deployed and scaled independently.
# Pin the official Node 22 multi-platform manifest for reproducible builds.
# The manifest includes linux/amd64 and linux/arm64 variants.
FROM node:22-bookworm-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9

ENV NODE_ENV=production
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev \
  && npm cache clean --force

COPY src ./src

USER node

CMD ["node", "src/workers/notification.worker.js"]
