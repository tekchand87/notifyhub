# Docker Compose local runtime template.
# Copy this file to Backend/.env and fill notification-provider credentials
# before running `docker compose up --build`. This file contains no real secrets.
# Compose overrides the endpoint values below explicitly so host-local values
# cannot accidentally make a container connect to itself.

NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://notifyhub:notifyhub_password@mongodb:27017/notifyhub?authSource=admin&directConnection=true
JWT_SECRET=replace-with-a-local-development-secret
JWT_EXPIRES_IN=1d

REDIS_URL=redis://redis:6379
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAILURE_MODE=fail-open

KAFKA_BROKERS=kafka:29092
KAFKA_PRODUCER_CLIENT_ID=notifyhub-api
KAFKA_CONSUMER_CLIENT_ID=notifyhub-worker
KAFKA_TOPIC=notifyhub.events
KAFKA_GROUP_ID=notifyhub-workers
KAFKA_DLQ_TOPIC=notifyhub.events.dlq
KAFKA_SSL=false

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WEBHOOK_ALLOW_LOCALHOST=true

# Email delivery is disabled until these local-only development values are set.
SMTP_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
