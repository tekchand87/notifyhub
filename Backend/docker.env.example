# Docker Compose local runtime template.
# Copy this file to Backend/.env and fill notification-provider credentials
# before running `docker compose up --build`. This file contains no real secrets.
# Compose overrides the endpoint values below explicitly so host-local values
# cannot accidentally make a container connect to itself. For AWS/ECS, inject
# an Atlas SRV URI through the task environment/secret manager instead of using
# this local template:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://notifyhub:notifyhub_password@mongodb:27017/notifyhub?authSource=admin&directConnection=true
JWT_SECRET=replace-with-a-local-development-secret
JWT_EXPIRES_IN=1d

REDIS_URL=redis://redis:6379
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAILURE_MODE=fail-open

# Local Docker always uses Kafka. SQS is an AWS/ECS deployment choice.
EVENT_BROKER=kafka
# Containers use the internal Docker listener. The host-local listener is
# localhost:9092; do not use that address from a backend/worker container.
KAFKA_BROKERS=kafka:29092
KAFKA_PRODUCER_CLIENT_ID=notifyhub-api
KAFKA_CONSUMER_CLIENT_ID=notifyhub-worker
KAFKA_TOPIC=notifyhub.events
KAFKA_GROUP_ID=notifyhub-workers
KAFKA_DLQ_TOPIC=notifyhub.events.dlq
KAFKA_SSL=false
# Leave SASL unset for the local PLAINTEXT broker. For AWS/ECS, replace the
# broker list and inject TLS/SCRAM values through the task definition/secret
# manager; never put production credentials in this file.

# SQS settings are intentionally unused in local Docker mode.
AWS_REGION=ap-south-1
SQS_EVENTS_QUEUE_URL=
SQS_DLQ_QUEUE_URL=
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT_SECONDS=60
SQS_MAX_MESSAGES=10

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WEBHOOK_ALLOW_LOCALHOST=true

# Email delivery is disabled until these local-only development values are set.
SMTP_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
